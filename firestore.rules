rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // member-review.html 전용. 인증 없이 URL을 아는 사람만 접근하는 구조이므로
    // 필드 형식·크기만 제한한다. (강한 접근 제어가 필요하면 member-review-setup.md의 "보안" 참고)
    match /suggestions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['report','quote','occ','text','name','cid','createdAt','resolved','replies'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.quote is string && request.resource.data.quote.size() <= 400
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','replies']);
      allow delete: if true;
    }
  }
}
